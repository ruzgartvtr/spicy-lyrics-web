{
  "manifest_version": 3,
  "name": "Spicy Lyrics Web",
  "version": "0.1.0",
  "description": "Word-synced lyrics on Spotify Web, using the public Spicy Lyrics API.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.spicylyrics.org/*",
    "https://open.spotify.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Spicy Lyrics Web",
    "default_popup": "options/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["src/content.js"],
      "css": ["src/panel.css"],
      "run_at": "document_idle",
      "type": "module"
    }
  ]
}
