{
  "manifest_version": 3,
  "name": "Spicy Lyrics Web",
  "version": "7.0.0",
  "description": "Synced lyrics on Spotify Web via Spicy Lyrics API.",
  "key": "",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://api.spicylyrics.org/*",
    "https://open.spotify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Spicy Lyrics Web",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
