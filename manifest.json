{
  "manifest_version": 3,
  "name": "Spicy Lyrics Web",
  "version": "6.3.158",
  "description": "Official Spicy Lyrics source, changed to run on Spotify Web.",
  "key": "",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://api.spicylyrics.org/*",
    "https://open.spotify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Spicy Lyrics Web",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["button.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["dist/spicy-lyrics.web.js"],
      "run_at": "document_idle"
    }
  ]
}
